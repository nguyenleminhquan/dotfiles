# shellcheck shell=bash
# Interactive zsh. ~/.zshenv (environment, PATH) has already run.

# Stops a bash started from inside zsh from switching back to zsh.
export DOTFILES_IN_ZSH=1

# After `exec zsh` from bash, SHELL still names bash, so screen/tmux windows
# would start bash (which then sees DOTFILES_IN_ZSH and stays bash).
if [[ ${SHELL:t} != zsh && -n ${commands[zsh]:-} ]]; then
  export SHELL="${commands[zsh]}"
fi

_df_dir="${DOTFILES_DIR:-$HOME/.dotfiles}"

# Aliases, EDITOR/VISUAL and history (sizes, sharing, secret filter) are shared
# with bash.
for _df_f in aliases history; do
  # shellcheck source=/dev/null
  [[ -r "$_df_dir/shell/$_df_f.sh" ]] && source "$_df_dir/shell/$_df_f.sh"
done

setopt interactive_comments no_beep

# Completion: the dump is cached under ~/.cache/zsh and `-C` skips the
# security scan and rebuild, which keeps startup fast. `-C` also means the dump
# is never refreshed by itself: install.sh deletes it whenever the generated
# completions in ~/.cache/zsh/completions change.
mkdir -p "$HOME/.cache/zsh"
# shellcheck disable=SC2206  # zsh expands the array unquoted
fpath=("$HOME/.cache/zsh/completions" $fpath)
autoload -Uz compinit
compinit -C -d "$HOME/.cache/zsh/zcompdump"
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# `k` completes like kubectl (the alias itself is in shell/aliases.sh). Needs
# kubectl's completion in the dump; a `k` alias defined later by the user wins.
# shellcheck disable=SC2154  # zsh parameters
if (( $+commands[kubectl] && $+_comps[kubectl] )); then compdef k=kubectl; fi

# Keys: emacs style, a few terminfo keys, and incremental history search.
bindkey -e
zmodload -F zsh/terminfo +p:terminfo 2>/dev/null
[[ -n ${terminfo[khome]:-} ]] && bindkey "${terminfo[khome]}" beginning-of-line
[[ -n ${terminfo[kend]:-} ]] && bindkey "${terminfo[kend]}" end-of-line
[[ -n ${terminfo[kdch1]:-} ]] && bindkey "${terminfo[kdch1]}" delete-char
bindkey '^R' history-incremental-pattern-search-backward

# fzf-tab replaces the completion menu with fzf. Upstream wants it after compinit
# and BEFORE plugins that wrap widgets (zsh-autosuggestions), and fzf's own key
# bindings (shell/tools.sh) after it: they save the Tab widget as
# fzf_default_completion, which must then be fzf-tab-complete. Same gate as fzf in
# tools.sh: a profile with tools (never minimal, whatever fzf the host has), a
# terminal on stdin and an fzf that can print its zsh script (0.48 or newer, the
# condition tools.sh needs for fzf's own init; an older fzf would leave fzf-tab
# without fzf's bindings). Vendored, so no download; the optional compiled
# module is left out and the pure-zsh path is used.
# The last condition is read from the init cache that tools.sh keeps
# (~/.cache/dotfiles/init/fzf-zsh, first line "# df-init bin=<path>"): the file
# exists only when that fzf printed its script, so an executable recorded binary
# answers it without running fzf, which costs a process (and, through a mise shim,
# several). The gate only reads the cache: tools.sh keys it on the binary it finds
# after mise is set up, and a second writer would make the two re-key it back and
# forth. Without a usable cache (the first start after an install, or a binary that
# moved) the check is run instead, once.
_df_profile=''
if [[ -r $HOME/.config/dotfiles/profile ]]; then read -r _df_profile <"$HOME/.config/dotfiles/profile" || :; fi
case $_df_profile in
  server | workstation)
    if [[ -t 0 && -r "$_df_dir/vendor/fzf-tab/fzf-tab.plugin.zsh" ]]; then
      _df_fzf_init=''
      if [[ -r $HOME/.cache/dotfiles/init/fzf-zsh ]]; then
        read -r _df_fzf_init <"$HOME/.cache/dotfiles/init/fzf-zsh" || :
      fi
      if [[ $_df_fzf_init == '# df-init bin='* && -x ${_df_fzf_init#'# df-init bin='} ]] ||
        { [[ -n ${commands[fzf]:-} ]] && fzf --zsh >/dev/null 2>&1; }; then
        # shellcheck source=/dev/null
        source "$_df_dir/vendor/fzf-tab/fzf-tab.plugin.zsh"
        # Upstream: no zsh menu, so that fzf-tab sees the whole candidate list.
        zstyle ':completion:*' menu no
      fi
      unset _df_fzf_init
    fi
    ;;
esac
unset _df_profile

# Suggestions from history, vendored so no download is ever needed.
# shellcheck disable=SC2034
ZSH_AUTOSUGGEST_STRATEGY=(history)
if [[ -r "$_df_dir/vendor/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  # shellcheck source=/dev/null
  source "$_df_dir/vendor/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

# mise, starship (or the minimal prompt) and fzf. Last, because fzf defines
# completions and key bindings that need compinit and the bindings above.
# shellcheck source=/dev/null
[[ -r "$_df_dir/shell/tools.sh" ]] && source "$_df_dir/shell/tools.sh"

# port, certinfo and netshoot (netshoot uses the kube helpers loaded above).
# shellcheck source=/dev/null
[[ -r "$_df_dir/shell/netdebug.sh" ]] && source "$_df_dir/shell/netdebug.sh"

unset _df_dir _df_f

# Per-machine overrides, kept out of git.
# shellcheck source=/dev/null
[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
return 0
