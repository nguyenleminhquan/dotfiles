#!/usr/bin/env bash
# The dotfiles command, linked to ~/.local/bin/dotfiles by every profile.
#
#   dotfiles update [install.sh options]   fetch the latest code and re-run install.sh
#   dotfiles doctor                        check the install (exit 1 on any FAIL)
#   dotfiles uninstall [--purge [--force]] run uninstall.sh
#   dotfiles profile                       print the installed profile
set -euo pipefail

# Where the libraries are: the checkout this script lives in (it is usually
# reached through the symlink in ~/.local/bin).
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd -P)"
state_dir="$HOME/.config/dotfiles"

die() {
  printf '[error] %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
usage: dotfiles <command>

commands:
  update [options]      fetch the latest code and re-run install.sh with the saved profile
  doctor                check the install; exit 1 when something FAILs
  uninstall [--purge [--force]]
                        remove the dotfiles; --purge also removes the tools and the checkout
                        (refused while a git checkout has unsaved work, --force overrides)
  profile               print the installed profile
EOF
}

# state_value <name>: first line of ~/.config/dotfiles/<name>; fails when it is missing.
state_value() {
  local value=''
  [ -r "$state_dir/$1" ] || return 1
  read -r value <"$state_dir/$1" || :
  [ -n "$value" ] || return 1
  printf '%s\n' "$value"
}

# The install location, resolved like install.sh and uninstall.sh do: the
# environment, then what the installer recorded, then ~/.dotfiles.
# shellcheck source=lib/dir.sh
. "$here/lib/dir.sh"
df_resolve_dir

# saved_profile: the profile install.sh recorded, or an error.
saved_profile() {
  state_value profile || die "dotfiles is not installed (no saved profile in $state_dir): run install.sh"
}

# update: where the new code comes from, first match wins:
#   1. $DOTFILES_SRC, a local checkout that install.sh mirrors into $DOTFILES_DIR
#   2. everything else is install.sh's own fetch (install.sh --update): the
#      git clone in $DOTFILES_DIR is brought to its ref (a branch fast-forwards,
#      a tag-pinned clone moves to the tag), or the repo recorded in
#      ~/.config/dotfiles/repo is downloaded as a tarball. One implementation,
#      so that update and install treat a clone the same way.
cmd_update() {
  local profile
  profile="$(saved_profile)"
  if [ -n "${DOTFILES_SRC:-}" ]; then
    exec bash "${DOTFILES_SRC%/}/install.sh" --profile "$profile" "$@"
  fi
  if [ ! -d "$DOTFILES_DIR/.git" ] && [ -z "${DOTFILES_REPO:-}" ] && ! state_value repo >/dev/null; then
    die "nothing to update from: $DOTFILES_DIR is not a git clone and no repo was recorded; set DOTFILES_SRC to a local checkout, or install with DOTFILES_REPO"
  fi
  [ -f "$DOTFILES_DIR/install.sh" ] || die "install.sh not found in $DOTFILES_DIR"
  run_installer_copy --update --profile "$profile" "$@"
}

# The copy run_installer_copy made, removed by its EXIT trap until the
# supervisor takes over.
installer_copy=''
_remove_installer_copy() {
  [ -z "$installer_copy" ] || rm -f -- "$installer_copy"
}

# run_installer_copy <install.sh args>: run $DOTFILES_DIR/install.sh from a
# private copy under $HOME and exit with its status. An update replaces
# $DOTFILES_DIR by renaming it, and bash keeps the script it runs open: Linux
# does not mind, but WSL1 refuses to rename a directory that holds an open
# file (EACCES). That goes for this script too (it is bin/dotfiles in
# $DOTFILES_DIR), so it cannot wait for the installer: it execs a supervisor
# given as a string, which holds no file open, and the supervisor runs the copy
# and deletes it on every way out, INT and TERM included. The copy also means
# the code being replaced is never the code being read. It has no lib/ beside
# it, so install.sh neither takes it for the checkout nor mirrors from it: it
# resolves the location from DOTFILES_DIR, which df_resolve_dir exported.
# Never /tmp, never outside $HOME.
run_installer_copy() {
  local cache="$HOME/.cache/dotfiles" made=0
  if [ ! -d "$cache" ]; then made=1; fi
  mkdir -p "$cache" || die "cannot create $cache for a private copy of install.sh"
  installer_copy="$(mktemp "$cache/install.XXXXXX")" || die "cannot create a private copy of install.sh in $cache"
  trap _remove_installer_copy EXIT
  cp -- "$DOTFILES_DIR/install.sh" "$installer_copy" || die "cannot copy $DOTFILES_DIR/install.sh to $installer_copy"
  # SC2016: the supervisor is meant to be expanded by the shell it starts.
  # shellcheck disable=SC2016
  exec bash -c '
    copy=$1 made=$2
    shift 2
    cleanup() {
      rm -f -- "$copy"
      if [ "$made" = 1 ]; then rmdir "${copy%/*}" 2>/dev/null || :; fi
    }
    trap cleanup EXIT
    trap "exit 130" INT
    trap "exit 143" TERM
    rc=0
    bash "$copy" "$@" || rc=$?
    exit "$rc"
  ' dotfiles-update "$installer_copy" "$made" "$@"
}

cmd_doctor() {
  # shellcheck source=lib/doctor.sh
  . "$here/lib/doctor.sh"
  if df_doctor; then exit 0; else exit 1; fi
}

cmd_uninstall() {
  [ -f "$DOTFILES_DIR/uninstall.sh" ] || die "uninstall.sh not found in $DOTFILES_DIR"
  exec bash "$DOTFILES_DIR/uninstall.sh" "$@"
}

main() {
  local cmd="${1:-}"
  [ $# -eq 0 ] || shift
  case "$cmd" in
    update) cmd_update "$@" ;;
    doctor) cmd_doctor ;;
    uninstall) cmd_uninstall "$@" ;;
    profile) saved_profile ;;
    help | -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
exit 0
