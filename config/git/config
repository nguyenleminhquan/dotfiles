# Shared git settings. Identity (name, email, signing key, credential helper)
# belongs in ~/.gitconfig.local, which is included at the end so that it can
# override anything here, and is never committed.

[core]
	editor = micro

[push]
	default = simple

[init]
	defaultBranch = main

[alias]
	s = status
	st = status
	stu = status --untracked-files=no
	ci = commit
	cim = commit --message
	cima = commit --all --message
	type = cat-file -t
	dump = cat-file -p
	la = !git config -l | grep alias | cut -c 7-
	ec = config --global -e

[include]
	path = ~/.gitconfig.local
