# Shared git settings, included from ~/.config/git/config (a real file the
# installer generates, so `git config --global` never writes into this one).
# Identity (name, email, signing key, credential helper) belongs in
# ~/.gitconfig.local, which that file includes after this one.
# No core.editor: git then falls back to $GIT_EDITOR, $VISUAL and $EDITOR,
# which shell/aliases.sh points at micro, nano or vi, whichever exists.

[push]
	default = simple

[init]
	defaultBranch = main

[alias]
	s = status
	st = status
	stu = status --untracked-files=no
	ci = commit
	cim = commit --message
	cima = commit --all --message
	type = cat-file -t
	dump = cat-file -p
	la = !git config -l | grep alias | cut -c 7-
	ec = config --global -e
