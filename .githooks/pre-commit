#!/usr/bin/env bash
# Blocks commits that add private IPs, credentials or company-specific strings.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

files=()
while IFS= read -r f; do files+=("$f"); done < <(git diff --cached --name-only --diff-filter=ACMR)
[ "${#files[@]}" -gt 0 ] || exit 0

if ! scripts/check-leaks.sh "${files[@]}"; then
  echo "pre-commit: leak guard failed, fix the matches above before committing" >&2
  exit 1
fi
